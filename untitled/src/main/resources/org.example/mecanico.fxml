<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.MecanicoViewController">
    <top>
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #66CDAA; -fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="MECÁNICOS">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: #FFFAFA;" text="Registrar Mecánicos">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="6.0" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Nombre Completo">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombreMecanico" maxWidth="350.0" prefHeight="30.0" prefWidth="350.0" />
                <Label text="Especialidad">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <ComboBox fx:id="cmbEspecialidad" maxWidth="350.0" prefHeight="30.0" prefWidth="350.0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Frenos y Transmisión" />
                            <String fx:value="Suspensión" />
                            <String fx:value="Bicicletas Eléctricas" />
                            <String fx:value="Cuadros y Estructura" />
                            <String fx:value="Mantenimiento General" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label text="Código Interno">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCodigo" maxWidth="350.0" prefHeight="30.0" prefWidth="350.0" />
                <HBox alignment="CENTER" prefHeight="45.0" prefWidth="200.0" spacing="30.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarMecanico" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Guardar">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Volver">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                <Label text="Mecánicos registrados">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaMecanicos" prefHeight="180.0" prefWidth="850.0">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre" />
                        <TableColumn fx:id="colEspecialidad" prefWidth="250.0" text="Especialidad" />
                        <TableColumn fx:id="colCodigo" prefWidth="200.0" text="Código" />
                        <TableColumn fx:id="colDisponible" prefWidth="180.0" text="Disponible" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" prefHeight="40.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarMecanico" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Editar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarMecanico" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #CD5C5C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Eliminar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
