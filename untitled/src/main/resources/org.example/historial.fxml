<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.HistorialViewController">
    <top>
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #66CDAA; -fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="HISTORIAL">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: #FFFAFA;" text="Historial de Servicios por Bicicleta">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <TextField fx:id="txtSerial" prefHeight="35.0" prefWidth="300.0" promptText="Buscar por número de serial" />
                        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarHistorial" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Buscar" />
                    </children>
                </HBox>

                <TableView fx:id="tablaHistorial" prefHeight="350.0" prefWidth="800.0" style="-fx-fixed-cell-size: 35;">
                    <columns>
                  <TableColumn fx:id="colCodigo" prefWidth="70.0" text="Código" />
                        <TableColumn fx:id="colFecha" text="Fecha" />
                  <TableColumn fx:id="colHora" prefWidth="60.0" text="Hora" />
                        <TableColumn fx:id="colMotivo" prefWidth="120.0" text="Motivo" />
                        <TableColumn fx:id="colDiagnostico" prefWidth="130.0" text="Diagnóstico" />
                        <TableColumn fx:id="colMecanico" prefWidth="120.0" text="Mecánico" />
                        <TableColumn fx:id="colTareas" prefWidth="150.0" text="Tareas" />
                  <TableColumn fx:id="colRepuestos" prefWidth="150.0" text="Repuestos" />
                        <TableColumn fx:id="colCosto" text="Costo" />
                    </columns>
                </TableView>

                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Volver">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>
