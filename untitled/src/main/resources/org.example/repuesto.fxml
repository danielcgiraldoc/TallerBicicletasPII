<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="420.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.RepuestoViewController">
    <top>
        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="100.0" style="-fx-background-color: #66CDAA; -fx-padding: 15;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="REPUESTO">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: #FFFAFA;" text="Registrar Repuesto">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Nombre">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombre" maxWidth="280.0" prefHeight="32.0" prefWidth="280.0" />
                <Label text="Cantidad">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCantidad" maxWidth="280.0" prefHeight="32.0" prefWidth="280.0" />
                <Label text="Costo">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCosto" maxWidth="280.0" prefHeight="32.0" prefWidth="280.0" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                      <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarRepuesto" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Guardar">
                          <font>
                              <Font size="16.0" />
                          </font>
                      </Button>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Cancelar">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
