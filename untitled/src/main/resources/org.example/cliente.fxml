<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.ClienteViewController">
   <top>
      <VBox alignment="CENTER" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #66CDAA; -fx-padding: 20;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="CLIENTES">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <Label style="-fx-text-fill: #FFFAFA;" text="Registrar Clientes">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Nombre Completo">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="txtNombre" maxWidth="350.0" prefHeight="35.0" prefWidth="350.0" />
            <Label text="Número de Identificación">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="txtIdentificacion" maxWidth="350.0" prefHeight="35.0" prefWidth="350.0" />
            <Label text="Teléfono">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="txtTelefono" maxWidth="350.0" prefHeight="35.0" prefWidth="350.0" />
            <Label text="Dirección">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="txtDireccion" maxWidth="350.0" prefHeight="35.0" prefWidth="350.0" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
               <children>
                  <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCliente" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Guardar">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #66CDAA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Volver">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
